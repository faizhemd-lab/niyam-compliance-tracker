{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "niyam",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-29",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Workers AI: a free engine (daily free allowance). Off for now: in testing,
  // the free models' replies failed the agent's checks on every turn and only
  // made turns slower. To switch it on, uncomment the line below.
  // "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "niyam-records",
      "database_id": "3d35b13a-8429-45de-aaab-4073c7aebd2b"
    }
  ],
  // Public values only. The publishable key is the same one the browser gets;
  // the Worker derives the Clerk JWKS from it. Local `.dev.vars` overrides these.
  "vars": {
    "CLERK_PUBLISHABLE_KEY": "pk_test_Y2FsbS1jcmF5ZmlzaC00MzU2LmNsZXJrLmFjY291bnRzLmRldiQ",
    "APP_ORIGIN": "https://niyam.niyam-compliance-tracker.workers.dev",
    // The agent's model: Gemini through Google AI Studio's OpenAI-compatible
    // endpoint (free tier). The key is a secret, never in this file:
    //   npx wrangler secret put MODEL_API_KEY
    "MODEL_BASE_URL": "https://generativelanguage.googleapis.com/v1beta/openai",
    "MODEL_NAME": "gemini-3.5-flash"
  },
  // The agent's autopilot: every day at 03:30 UTC (09:00 IST).
  "triggers": { "crons": ["30 3 * * *"] },
  "observability": { "enabled": true }
}
